# LLM Provider API Keys (at least one required, or use Ollama)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# OPENAI_API_KEY=sk-proj-your-key-here

# Optional: Encryption key for vault credential storage (auto-generated on first run)
# VAULT_ENCRYPTION_KEY=

# Optional: Server port (default: 3001)
# PORT=3001

# Optional: SQLite database path (default: data/oma.db)
# DATABASE_PATH=data/oma.db

# Optional: Path to governance config file for infra-as-code deployments
# GOVERNANCE_CONFIG=governance.json

# Daytona sandbox API key (required in production for bash + file tools).
# Without it, the server falls back to a host-process LocalSandbox in
# non-production environments only. Refuses to start in production
# without DAYTONA_API_KEY when sandboxed tools are reachable.
# DAYTONA_API_KEY=

# ── OAuth (MCP connectors) ──────────────────────────────────────────────
# OMA discovers each MCP server's OAuth endpoints from
# /.well-known/oauth-authorization-server (RFC 8414) and, when the
# server supports it, dynamically registers a client via /register
# (RFC 7591). Servers that support DCR (Notion) require NO per-provider
# env vars — just click Connect.
#
# Servers that DON'T support DCR (Slack, Google Drive, …) require the
# admin to register an OAuth app in the provider's developer console
# once and paste credentials below. The env-var convention is:
#   <CONNECTOR_ID>_OAUTH_CLIENT_ID
#   <CONNECTOR_ID>_OAUTH_CLIENT_SECRET
# (hyphens in connector IDs are normalized to underscores)
#
# Redirect URI to register against the provider's OAuth app:
#   <OAUTH_CALLBACK_BASE_URL>/v1/mcp/connectors/<connector_id>/oauth/callback
#
# Override the callback base. In dev this should be the WEB origin
# (Vite, e.g. http://localhost:5173). In prod, typically the single
# public host that fronts both web + API.
# OAUTH_CALLBACK_BASE_URL=https://your.host
#
# ─ Slack ─
# Requires a Marketplace-published OR Internal Slack app
# (https://api.slack.com/apps). Enable Model Context Protocol in the
# app settings. Scopes are pre-set in the connector catalog.
# SLACK_OAUTH_CLIENT_ID=
# SLACK_OAUTH_CLIENT_SECRET=
#
# ─ Google Drive ─
# Requires a Google Cloud project with Drive API + Drive MCP API
# enabled, an OAuth consent screen configured, and an OAuth Desktop
# client created. See:
#   https://developers.google.com/workspace/drive/api/guides/configure-mcp-server
# GOOGLE_DRIVE_OAUTH_CLIENT_ID=
# GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
