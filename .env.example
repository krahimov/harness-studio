# LLM Provider API Keys (at least one required, or use Ollama)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# OPENAI_API_KEY=sk-proj-your-key-here

# Optional: Encryption key for vault credential storage (auto-generated on first run)
# VAULT_ENCRYPTION_KEY=

# Optional: Server port (default: 3001)
# PORT=3001

# Optional: SQLite database path (default: data/oma.db)
# DATABASE_PATH=data/oma.db

# Optional: Path to governance config file for infra-as-code deployments
# GOVERNANCE_CONFIG=governance.json

# Daytona sandbox API key (required in production for bash + file tools).
# Without it, the server falls back to a host-process LocalSandbox in
# non-production environments only. Refuses to start in production
# without DAYTONA_API_KEY when sandboxed tools are reachable.
# DAYTONA_API_KEY=

# ── OAuth (MCP connectors) ──────────────────────────────────────────────
# Each OAuth-based MCP connector reads its client credentials from env
# vars by convention:
#   <CONNECTOR_ID>_OAUTH_CLIENT_ID
#   <CONNECTOR_ID>_OAUTH_CLIENT_SECRET
# You register one OAuth app per provider in their developer console,
# set the callback URL to:
#   <OAUTH_CALLBACK_BASE_URL>/v1/mcp/connectors/<connector_id>/oauth/callback
# (default base is http://localhost:3001 for dev), then paste the
# generated credentials here.
#
# Override the callback base. In dev this should be the WEB origin
# (Vite, e.g. http://localhost:5173) so the post-callback 302 to
# /quickstart resolves on the page the user is actually on. In prod,
# typically the single public host that fronts both web + API.
# OAUTH_CALLBACK_BASE_URL=https://your.host
#
# Notion (https://developers.notion.com → Public integration):
# NOTION_OAUTH_CLIENT_ID=
# NOTION_OAUTH_CLIENT_SECRET=
#
# More providers (slack, linear, asana, …) follow the same pattern as
# they're wired into OAUTH_PROVIDERS in packages/server/src/lib/oauth.ts.
